"ai_prompt_hint" = "Copia el prompt de abajo a cualquier IA (Doubao, ChatGPT…), envía la captura de tu horario, y pega la salida de la IA en el campo de texto de arriba para importar.";
"ai_prompt_text" = "Convierte la captura de horario que te envío a continuación en texto plano con estas reglas:\\n1. Una línea por sesión de clase, 7 columnas separadas por tabulaciones: curso, profesor, aula, día, periodo, semanas, tipo\\n2. Día como número: 1=lunes … 7=domingo\\n3. Periodo como rango, p. ej. 1-2; un solo periodo es solo el número, p. ej. 3\\n4. Semanas como rango, p. ej. 1-16; cursos parciales usan el rango real, p. ej. 1-8\\n5. Tipo: 0=todas las semanas, 1=impares, 2=pares\\n6. Si el profesor o el aula no aparecen en la captura, usa - como marcador; nunca inventes valores\\n7. Un curso con varios horarios se divide en varias líneas; sin espacios dentro de los nombres\\n8. La primera línea debe ser exactamente <<<SLEEPY-BEGIN>>> y la última exactamente <<<SLEEPY-END>>>, con las líneas de cursos en medio; nada fuera de esas dos líneas — sin explicaciones, ejemplos ni bloques de código\\n\\n9. Si la captura muestra los horarios de cada periodo arriba (p. ej. \"Periodo 1 08:00-09:35\"), escríbelos tal cual, una línea por periodo, antes de las líneas de cursos. Formato: PeriodoN HH:mm HH:mmEjemplo de salida (solo referencia de formato, no copies el contenido):\\n<<<SLEEPY-BEGIN>>>\\nCálculo\\tJuan\\tA101\\t1\\t1-2\\t1-16\\t0\\nInglés\\tMaría\\tB202\\t3\\t3-4\\t1-16\\t1\\n<<<SLEEPY-END>>>";
"ai_prompt_title" = "Deja que la IA convierta tu captura";
"copied" = "Copiado";
"copy_prompt" = "Copiar prompt";
"edit_table_delete_msg_count" = "¿Eliminar el horario \"%1$@\"? Sus %2$d cursos también se eliminarán. Esto no se puede deshacer.";
"format_detail_content_desc" = "Ver detalles del formato";
"format_help_close" = "Entendido";
"format_help_example" = "Ejemplo";
"format_help_spec" = "Requisitos de reconocimiento";
"import_dropped_hint" = "Estas líneas se omitieron. Revisa su formato y vuelve a importar:";
"import_dropped_title" = "%1$d líneas no se pudieron analizar";
"schedule_week_prefix" = "Semana %1$d";
"semester_ended" = "El semestre terminó";
"semester_not_started" = "El semestre aún no comienza";
"today_semester_out_hint" = "Fuera del rango del semestre: las clases son solo de referencia";
"format_wakeup_share_when" = "Migrar todo desde la app WakeUp. Copia el texto completo generado por \"Compartir cursos\" de WakeUp y pégalo tal cual.";
"format_wakeup_share_example" = "【来自WakeUp课程表】\\n课程分享:\\n{\"name\":\"Mi horario\",\"startDate\":\"2026-09-07\",\"courseDetailJson\":\"%5B%7B%22name%22…%5D\"}";
"format_wakeup_json_when" = "Contenido de un .json exportado por WakeUp, o JSON escrito por ti con esta estructura.";
"format_wakeup_json_example" = "{\\n  \"name\": \"Mi horario\",\\n  \"startDate\": \"2026-09-07\",\\n  \"courses\": [\\n    {\"name\":\"Cálculo\",\"teacher\":\"Juan\",\"position\":\"A101\",\"day\":1,\"startNode\":1,\"step\":2,\"startWeek\":1,\"endWeek\":16,\"type\":0}\\n  ]\\n}";
"format_ics_when" = "Archivos de calendario (.ics) exportados del sistema escolar o WakeUp. Selecciónalo con \"Importar desde archivo\", o ábrelo en un editor de texto y pega todo.";
"format_ics_example" = "BEGIN:VCALENDAR\\nBEGIN:VEVENT\\nSUMMARY:Cálculo\\nLOCATION:A101\\nDESCRIPTION:第1 - 2节\\\\nA101\\\\nJuan\\nDTSTART:20260907T010000Z\\nDTEND:20260907T015500Z\\nRRULE:FREQ=WEEKLY;UNTIL=20261227T010000Z\\nEND:VEVENT\\nEND:VCALENDAR";
"format_csv_when" = "Tablas exportadas del registro escolar, o Excel guardado como \"CSV (delimitado por comas)\".";
