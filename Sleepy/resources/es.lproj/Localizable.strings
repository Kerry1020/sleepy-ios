"format_plain_when" = "El formato más flexible: una línea por sesión de clase. Sirve para escribir a mano, y mejor aún para texto generado por IA desde capturas (ver prompt abajo).";
"format_plain_example" = "<<<SLEEPY-BEGIN>>>\\n第1节 08:00-09:35\\n第2節 09:55-11:30\\n第3节 13:30-15:05\\nCálculo\\tJuan\\tA101\\t1\\t1-2\\t1-16\\t0\\nInglés\\tMaría\\tB202\\t3\\t3-4\\t1-16\\t1\\nDeporte\\t-\\t-\\t5\\t3\\t1-16\\t2\\n<<<SLEEPY-END>>>";
